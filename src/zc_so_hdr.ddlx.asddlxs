@Metadata.layer: #CORE
@UI: { 
    headerInfo: { 
        typeName: 'Point of Sale',
        title: { 
            value: 'Customername'
        },
        description: {
            value : 'Mobile'
        },
//         typeImageUrl: 'CustomerImage'
        typeImageUrl: 'https://static.vecteezy.com/system/resources/previews/019/875/701/large_2x/man-in-suit-sitting-with-laptop-businessman-sitting-working-in-front-of-laptop-free-png.png'
    }
}

//@UI.chart: [{ 
//    qualifier: 'itemChart',
//    chartType: #COLUMN,
//    dimensions: [ '_itemChart.Material' ],
//    measures: [ '_itemChart.Grossvalue' ],
//    dimensionAttributes: [
//     { 
//        dimension: '_itemChart.Material',
//        role: #CATEGORY    
//     }
//    ],
//    
//    measureAttributes: [
//     { 
//        measure: '_itemChart.Grossvalue',
//        role: #AXIS_1
//     }
//    ]
//}]
//
